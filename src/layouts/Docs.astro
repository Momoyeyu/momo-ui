---
import Shell from './Shell.astro';
import DocsNav from '../components/DocsNav.astro';
const {frontmatter} = Astro.props;
---
<Shell title={frontmatter.title} description={frontmatter.description}>
  <div class="docs-layout">
    <aside class="docs-sidebar"><DocsNav/></aside>
    <details class="docs-mobile-nav">
      <summary>组件目录</summary>
      <DocsNav/>
    </details>
    <main class="docs-main" id="main">
      <header class="doc-heading">
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
      </header>
      <article class="prose"><slot/></article>
    </main>
  </div>
</Shell>
