---
import {groups,path} from '../catalog';
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---
<nav aria-label="文档导航">
  {groups.map(group => <div class="nav-group">
    <p>{group.label}</p>
    {group.pages.map(page => {
      const href = path('components/' + page.slug + '/');
      return <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{page.title}</a>;
    })}
  </div>)}
</nav>
